---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MascotCompanion from "../components/MascotCompanion.astro";
import ProductGroup from "../components/ProductGroup.astro";
import ProductDetail from "../components/ProductDetail.astro";
import { getCollection } from "astro:content";

const products = (await getCollection("products", ({ data }) => data.published))
  .map(({ data }) => data)
  .sort((a, b) => a.order - b.order);
const personalProducts = products.filter((product) => product.category === "personal");
const professionalProducts = products.filter((product) => product.category === "professional");
const detailedProducts = products.filter((product) => product.detail?.enabled);
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="白板录屏工具、诗词图谱，以及房贷止赎数据血缘与 ALM 经营分析报表等银行专业作品。">
  <meta name="theme-color" content="#f7f3ea">
  <title>LEEWEN · 个人产品与银行数据专业作品</title>
  <style is:global>
    :root {
      --paper: #f7f3ea;
      --paper-deep: #eee7da;
      --card: #fffdf8;
      --ink: #20242b;
      --navy: #263b5a;
      --navy-soft: #3e577a;
      --orange: #c7653d;
      --orange-dark: #a84c2c;
      --muted: #667085;
      --line: #ded8cc;
      --green: #496b5b;
      --shadow: 0 18px 50px rgba(38, 59, 90, .10);
      --radius-lg: 28px;
      --radius-md: 18px;
      --max: 1180px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 8% 5%, rgba(199, 101, 61, .08), transparent 27rem),
        radial-gradient(circle at 92% 14%, rgba(38, 59, 90, .08), transparent 30rem),
        var(--paper);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
        "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; }
    img { display: block; max-width: 100%; }
    button, a { -webkit-tap-highlight-color: transparent; }

    .skip-link {
      position: fixed;
      z-index: 1000;
      top: 10px;
      left: 10px;
      padding: 10px 14px;
      border-radius: 10px;
      color: #fff;
      background: var(--navy);
      transform: translateY(-160%);
    }
    .skip-link:focus { transform: translateY(0); }

    .site-header {
      position: sticky;
      z-index: 100;
      top: 0;
      border-bottom: 1px solid rgba(222, 216, 204, .82);
      background: rgba(247, 243, 234, .88);
      backdrop-filter: blur(16px);
    }

    .nav-wrap {
      position: relative;
      width: min(calc(100% - 40px), var(--max));
      min-height: 72px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: inline-flex;
      align-items: baseline;
      gap: 9px;
      text-decoration: none;
      font-weight: 850;
      letter-spacing: .12em;
      color: var(--navy);
    }
    .brand small {
      font-weight: 650;
      letter-spacing: .08em;
      color: var(--muted);
    }

    .nav-panel {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .nav-links a {
      padding: 9px 10px;
      border-radius: 10px;
      color: var(--muted);
      text-decoration: none;
      font-size: .94rem;
      font-weight: 650;
    }
    .nav-links a:hover,
    .nav-links a:focus-visible {
      color: var(--navy);
      background: rgba(38, 59, 90, .06);
    }

    .lang-switch {
      display: flex;
      gap: 3px;
      padding: 3px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
    }
    .lang-switch button {
      min-width: 38px;
      padding: 6px 8px;
      border: 0;
      border-radius: 8px;
      color: var(--muted);
      background: transparent;
      font: inherit;
      font-size: .8rem;
      font-weight: 800;
      cursor: pointer;
    }
    .lang-switch button[aria-pressed="true"] {
      color: #fff;
      background: var(--navy);
    }

    .menu-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: var(--navy);
      background: var(--card);
      font: inherit;
      font-weight: 850;
      cursor: pointer;
    }

    .button {
      display: inline-flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 18px;
      border: 1px solid transparent;
      border-radius: 13px;
      text-decoration: none;
      font-weight: 800;
      line-height: 1.2;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .button:hover { transform: translateY(-2px); }
    .button:focus-visible,
    .menu-toggle:focus-visible,
    .lang-switch button:focus-visible,
    summary:focus-visible {
      outline: 3px solid rgba(199, 101, 61, .35);
      outline-offset: 3px;
    }
    .button-primary {
      color: #fff;
      background: var(--orange);
      box-shadow: 0 10px 24px rgba(199, 101, 61, .25);
    }
    .button-primary:hover { background: var(--orange-dark); }
    .button-secondary {
      color: var(--navy);
      border-color: var(--line);
      background: rgba(255, 253, 248, .82);
    }
    .button-ink {
      color: #fff;
      background: var(--navy);
    }

    main { overflow: hidden; }
    .section {
      width: min(calc(100% - 40px), var(--max));
      margin: 0 auto;
      padding: 90px 0;
    }
    .section-tight { padding-top: 24px; }
    .section-heading {
      max-width: 720px;
      margin-bottom: 34px;
    }
    .eyebrow {
      margin: 0 0 10px;
      color: var(--orange);
      font-size: .78rem;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    h1, h2, h3 {
      margin-top: 0;
      color: var(--navy);
      line-height: 1.15;
      letter-spacing: -.03em;
    }
    h1 {
      max-width: 820px;
      margin-bottom: 20px;
      font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
      font-size: clamp(2.6rem, 6vw, 5.4rem);
      font-weight: 800;
    }
    h2 {
      margin-bottom: 12px;
      font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
      font-size: clamp(2rem, 4vw, 3.3rem);
    }
    h3 { font-size: 1.35rem; }
    .lead {
      max-width: 760px;
      margin: 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 2vw, 1.28rem);
    }

    .hero { padding-top: 40px; }
    .product-group-heading { margin-bottom: 34px; }
    .product-group-heading.compact {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-left: 38px;
      margin-bottom: 18px;
    }
    .product-group-heading.compact .eyebrow { margin: 0; }
    .product-group-heading.compact::after {
      flex: 1;
      height: 1px;
      background: var(--line);
      content: "";
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
    .product-card {
      position: relative;
      min-width: 0;
      padding: 18px;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: rgba(255, 253, 248, .92);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .product-card::after {
      position: absolute;
      right: -60px;
      bottom: -70px;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: rgba(199, 101, 61, .08);
      content: "";
      pointer-events: none;
    }
    .product-card.poetry::after { background: rgba(73, 107, 91, .10); }
    .product-card.lineage::after,
    .product-card.image::after { background: rgba(38, 59, 90, .10); }
    .product-visual {
      position: relative;
      height: 250px;
      margin-bottom: 24px;
      border-radius: 20px;
      background: #f0ebe1;
      overflow: hidden;
    }
    .product-content {
      flex: 1;
      padding: 0 10px 10px;
      display: flex;
      flex-direction: column;
    }
    .product-label {
      display: inline-flex;
      margin-bottom: 12px;
      padding: 5px 9px;
      border-radius: 99px;
      color: var(--orange-dark);
      background: rgba(199, 101, 61, .11);
      font-size: .76rem;
      font-weight: 850;
    }
    .poetry .product-label {
      color: var(--green);
      background: rgba(73, 107, 91, .11);
    }
    .professional .product-label {
      color: var(--navy);
      background: rgba(38, 59, 90, .11);
    }
    .professional .button-primary { background: var(--navy); }
    .professional .button-primary:hover { background: var(--navy-soft); }
    .product-content h2 {
      margin-bottom: 12px;
      font-family: inherit;
      font-size: clamp(1.65rem, 3vw, 2.25rem);
    }
    .product-content p {
      min-height: 3.3em;
      margin: 0 0 18px;
      color: var(--muted);
    }
    .audience {
      min-height: 2.5em;
      margin-bottom: 20px;
      color: var(--navy);
      font-size: .88rem;
      font-weight: 750;
    }
    .card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: auto;
    }
    .product-visual > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top left;
    }
    .generic-product-visual {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 24px;
      color: var(--navy);
      background: linear-gradient(145deg, #edf0f5, #e0e6ee);
      font: 800 1.2rem/1.4 "Songti SC", serif;
      text-align: center;
    }

    .whiteboard-ui {
      position: absolute;
      inset: 18px;
      border: 1px solid #d7d0c4;
      border-radius: 14px;
      background:
        linear-gradient(rgba(38, 59, 90, .05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(38, 59, 90, .05) 1px, transparent 1px),
        #fffdf9;
      background-size: 22px 22px;
      box-shadow: 0 12px 28px rgba(38, 59, 90, .12);
    }
    .tool-rail {
      position: absolute;
      top: 18px;
      left: 18px;
      display: flex;
      gap: 7px;
      padding: 7px;
      border: 1px solid #e4ded4;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 6px 16px rgba(38, 59, 90, .1);
    }
    .tool-rail i {
      display: block;
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: #e9edf3;
    }
    .tool-rail i:nth-child(2) { background: #f1d8cd; }
    .tool-rail i:nth-child(3) { background: #d9e5df; }
    .record-pill {
      position: absolute;
      top: 18px;
      right: 18px;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border-radius: 99px;
      color: #a23124;
      background: #fff;
      box-shadow: 0 6px 16px rgba(38, 59, 90, .1);
      font-size: .72rem;
      font-weight: 900;
    }
    .record-pill::before {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d94b3d;
      content: "";
    }
    .board-note {
      position: absolute;
      left: 18%;
      top: 42%;
      width: 44%;
      padding: 12px;
      border-left: 4px solid var(--orange);
      color: var(--navy);
      background: rgba(255, 248, 212, .88);
      font-family: "Songti SC", serif;
      font-size: 1rem;
      font-weight: 800;
      transform: rotate(-2deg);
    }
    .board-arrow {
      position: absolute;
      right: 18%;
      bottom: 25%;
      width: 26%;
      height: 34px;
      border-bottom: 3px solid var(--navy-soft);
      border-radius: 50%;
      transform: rotate(-10deg);
    }
    .board-arrow::after {
      position: absolute;
      right: -2px;
      bottom: -7px;
      width: 11px;
      height: 11px;
      border-right: 3px solid var(--navy-soft);
      border-bottom: 3px solid var(--navy-soft);
      content: "";
      transform: rotate(-45deg);
    }

    .poetry-map {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 50%, rgba(73, 107, 91, .14), transparent 38%),
        linear-gradient(145deg, #f2ece0, #e8efe9);
    }
    .map-line {
      position: absolute;
      height: 2px;
      background: rgba(38, 59, 90, .28);
      transform-origin: left center;
    }
    .line-a { top: 44%; left: 29%; width: 42%; transform: rotate(-12deg); }
    .line-b { top: 51%; left: 48%; width: 34%; transform: rotate(33deg); }
    .line-c { top: 51%; left: 20%; width: 32%; transform: rotate(41deg); }
    .line-d { top: 33%; left: 48%; width: 28%; transform: rotate(-48deg); }
    .map-node {
      position: absolute;
      display: grid;
      place-items: center;
      width: 76px;
      aspect-ratio: 1;
      border: 2px solid rgba(255, 255, 255, .88);
      border-radius: 50%;
      color: #fff;
      background: var(--navy);
      box-shadow: 0 10px 24px rgba(38, 59, 90, .2);
      font-family: "Songti SC", serif;
      font-weight: 850;
    }
    .node-main { top: 34%; left: calc(50% - 38px); width: 88px; background: var(--orange); }
    .node-a { top: 14%; left: 18%; }
    .node-b { top: 14%; right: 15%; background: var(--green); }
    .node-c { bottom: 12%; left: 18%; background: var(--navy-soft); }
    .node-d { right: 14%; bottom: 11%; background: #8b674e; }

    /* FCL Pipeline Explorer — 数据血缘 / 多层 Pipeline 视觉 */
    .lineage-ui {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 50%, rgba(38, 59, 90, .12), transparent 40%),
        linear-gradient(160deg, #e9ecf2, #dfe3eb);
    }
    .lineage-edge {
      position: absolute;
      height: 2px;
      background: linear-gradient(to right, rgba(38, 59, 90, .45), rgba(38, 59, 90, .15));
      transform-origin: left center;
    }
    .lineage-edge.edge-1 { top: 38%; left: 22%; width: 30%; transform: rotate(20deg); }
    .lineage-edge.edge-2 { top: 38%; left: 52%; width: 30%; transform: rotate(-20deg); }
    .lineage-edge.edge-3 { top: 56%; left: 30%; width: 22%; transform: rotate(35deg); }
    .lineage-edge.edge-4 { top: 56%; left: 52%; width: 22%; transform: rotate(-35deg); }
    .lineage-edge.edge-5 { top: 47%; left: 26%; width: 48%; transform: rotate(0deg); }
    .lineage-node {
      position: absolute;
      display: grid;
      place-items: center;
      width: 60px;
      aspect-ratio: 1;
      border: 2px solid rgba(255, 255, 255, .92);
      border-radius: 50%;
      color: #fff;
      background: var(--navy);
      box-shadow: 0 8px 20px rgba(38, 59, 90, .22);
      font-size: .72rem;
      font-weight: 850;
      text-align: center;
      line-height: 1.1;
      padding: 4px;
    }
    .lineage-node.node-source-a { top: 24%; left: 14%; background: var(--orange); width: 70px; }
    .lineage-node.node-source-b { top: 24%; right: 14%; background: var(--navy-soft); width: 70px; }
    .lineage-node.node-app { top: 50%; left: calc(50% - 42px); width: 84px; background: var(--navy); }
    .lineage-node.node-report { bottom: 12%; left: calc(50% - 32px); background: var(--green); width: 64px; }
    .lineage-pill {
      position: absolute;
      top: 14px;
      right: 14px;
      padding: 4px 9px;
      border-radius: 99px;
      color: var(--navy);
      background: rgba(255, 255, 255, .82);
      font-size: .7rem;
      font-weight: 850;
      letter-spacing: .04em;
    }

    .professional-group {
      margin-top: 24px;
      padding: clamp(34px, 6vw, 68px);
      border: 1px solid rgba(38, 59, 90, .14);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(135deg, rgba(38, 59, 90, .075), rgba(255, 253, 248, .88)),
        var(--card);
    }
    .professional-group .product-group-heading { max-width: 850px; }

    .product-detail { scroll-margin-top: 90px; }
    .detail-shell {
      display: grid;
      grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
      gap: clamp(28px, 5vw, 58px);
      align-items: start;
      padding: clamp(22px, 4vw, 46px);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow);
    }
    .detail-image {
      position: sticky;
      top: 92px;
      max-height: 720px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: #f1f3f6;
      overflow: auto;
    }
    .detail-image img { width: 100%; }
    .detail-copy .lead { margin-bottom: 28px; }
    .detail-copy h3 {
      margin: 28px 0 12px;
      font-size: 1.05rem;
      letter-spacing: 0;
    }
    .detail-metrics {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .detail-metric {
      padding: 16px 12px;
      border-radius: 14px;
      color: var(--navy);
      background: rgba(38, 59, 90, .07);
      text-align: center;
    }
    .detail-metric strong {
      display: block;
      font-size: 1.7rem;
      line-height: 1.15;
    }
    .detail-metric span {
      color: var(--muted);
      font-size: .78rem;
    }
    .detail-roles {
      margin: 0;
      padding-left: 1.25rem;
      color: var(--muted);
    }
    .detail-roles li + li { margin-top: 8px; }
    .capability-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .capability-list li {
      padding: 7px 11px;
      border: 1px solid rgba(38, 59, 90, .14);
      border-radius: 99px;
      color: var(--navy);
      background: rgba(38, 59, 90, .045);
      font-size: .84rem;
      font-weight: 750;
    }
    .module-details {
      margin-top: 26px;
      border-block: 1px solid var(--line);
    }
    .module-details summary {
      padding: 16px 2px;
      color: var(--navy);
      cursor: pointer;
      font-weight: 850;
    }
    .module-details > div { padding: 0 2px 18px; }
    .module-details h3 { margin-top: 4px; }
    .module-details ul { margin-bottom: 0; padding-left: 1.25rem; color: var(--muted); }
    .demo-notice {
      margin: 22px 0;
      padding: 14px 16px;
      border-left: 3px solid var(--orange);
      color: var(--muted);
      background: rgba(199, 101, 61, .06);
      font-size: .88rem;
    }

    .scenario-grid,
    .steps-grid,
    .article-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .scenario,
    .step-card,
    .article-card {
      padding: 26px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: rgba(255, 253, 248, .72);
    }
    .scenario-number,
    .step-number {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      margin-bottom: 30px;
      border-radius: 10px;
      color: #fff;
      background: var(--navy);
      font-weight: 900;
    }
    .scenario p,
    .step-card p,
    .article-card p { color: var(--muted); }
    .text-link {
      color: var(--orange-dark);
      font-weight: 850;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
    }

    .demo-band {
      border-block: 1px solid var(--line);
      background: rgba(238, 231, 218, .52);
    }
    .steps-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .step-card { background: var(--card); }
    .step-number { margin-bottom: 20px; background: var(--orange); }

    .creator-card {
      display: grid;
      grid-template-columns: minmax(260px, .72fr) minmax(0, 1.28fr);
      gap: 46px;
      align-items: center;
      padding: clamp(22px, 5vw, 54px);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow);
    }
    .portrait-frame {
      position: relative;
      max-width: 390px;
      margin: 0 auto;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: var(--paper);
      transform: rotate(-1.2deg);
    }
    .portrait-frame::before {
      position: absolute;
      inset: 8px -8px -8px 8px;
      z-index: -1;
      border: 2px solid rgba(199, 101, 61, .28);
      border-radius: 28px;
      content: "";
    }
    .portrait-frame img {
      width: 100%;
      border-radius: 20px;
      filter: sepia(.08) contrast(.98);
    }
    .trust-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 24px 0;
      padding: 0;
      list-style: none;
    }
    .trust-tags li {
      padding: 7px 11px;
      border: 1px solid var(--line);
      border-radius: 99px;
      color: var(--navy);
      background: var(--paper);
      font-size: .83rem;
      font-weight: 750;
    }
    .about-details {
      margin-top: 24px;
      border-top: 1px solid var(--line);
      padding-top: 18px;
    }
    .about-details summary {
      width: max-content;
      color: var(--orange-dark);
      font-weight: 850;
      cursor: pointer;
    }
    .about-copy {
      max-width: 720px;
      padding-top: 12px;
      color: var(--muted);
    }
    .about-copy h3 { margin: 22px 0 6px; color: var(--navy); }

    .article-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .article-card {
      display: flex;
      min-height: 240px;
      flex-direction: column;
    }
    .article-type {
      margin-bottom: 24px;
      color: var(--green);
      font-size: .76rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .article-card h3 { margin-bottom: 10px; }
    .article-card p { margin-top: 0; }
    .article-card .text-link { margin-top: auto; }

    .contact-card {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(220px, .6fr);
      gap: 44px;
      align-items: center;
      padding: clamp(26px, 6vw, 64px);
      border-radius: var(--radius-lg);
      color: #fff;
      background: var(--navy);
      overflow: hidden;
    }
    .contact-card::after {
      position: absolute;
      top: -90px;
      right: -70px;
      width: 290px;
      height: 290px;
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 50%;
      content: "";
    }
    .contact-card h2,
    .contact-card .eyebrow { color: #fff; }
    .contact-card p { max-width: 650px; color: rgba(255, 255, 255, .72); }
    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
    }
    .contact-actions .button-secondary {
      color: #fff;
      border-color: rgba(255, 255, 255, .24);
      background: rgba(255, 255, 255, .08);
    }
    .qr-card {
      position: relative;
      z-index: 1;
      padding: 14px;
      border-radius: 18px;
      color: var(--ink);
      background: #fff;
      text-align: center;
    }
    .qr-card img {
      width: 100%;
      max-width: 220px;
      margin: 0 auto;
      border-radius: 8px;
    }
    .qr-card strong { display: block; margin-top: 10px; }
    .qr-card small { color: var(--muted); }

    footer {
      width: min(calc(100% - 40px), var(--max));
      margin: 0 auto;
      padding: 34px 0 44px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: .86rem;
    }
    footer a { color: var(--navy); }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 1100px) {
      .detail-shell { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
    }

    @media (max-width: 900px) {
      .nav-panel { gap: 10px; }
      .nav-links { display: none; }
      .product-grid,
      .creator-card,
      .contact-card,
      .detail-shell { grid-template-columns: 1fr; }
      .product-card { max-width: 720px; }
      .product-grid { justify-items: center; }
      .detail-image { position: static; max-height: 560px; }
      .creator-card { gap: 30px; }
      .creator-copy { order: -1; }
      .portrait-frame { max-width: 320px; }
      .article-grid { grid-template-columns: 1fr; }
      .article-card { min-height: auto; }
      .qr-card { max-width: 250px; }
    }

    @media (max-width: 900px) {
      .nav-wrap { width: min(calc(100% - 28px), var(--max)); }
      .menu-toggle { display: inline-grid; place-items: center; }
      .nav-panel {
        position: absolute;
        top: 62px;
        right: 0;
        width: min(320px, calc(100vw - 28px));
        padding: 14px;
        display: none;
        align-items: stretch;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--card);
        box-shadow: var(--shadow);
      }
      .nav-panel[data-open="true"] { display: grid; }
      .nav-links { display: grid; }
      .nav-links a { padding: 11px 12px; }
      .lang-switch { width: max-content; }
      .nav-cta { width: 100%; }
      .section {
        width: min(calc(100% - 28px), var(--max));
        padding: 68px 0;
      }
      .hero { padding-top: 24px; }
      .product-grid,
      .scenario-grid,
      .steps-grid { grid-template-columns: 1fr; }
      .product-card { padding: 12px; border-radius: 22px; }
      .professional-group { padding: 34px 14px; border-radius: 22px; }
      .product-group-heading.compact { padding-left: 28px; }
      .product-visual { height: 220px; }
      .product-content { padding: 0 6px 8px; }
      .audience, .product-content p { min-height: 0; }
      .card-actions .button { width: 100%; }
      .map-node { width: 62px; font-size: .82rem; }
      .node-main { width: 76px; left: calc(50% - 38px); }
      .contact-card { gap: 30px; }
      .detail-shell { padding: 14px; }
      .detail-metrics { grid-template-columns: 1fr; }
      footer { width: min(calc(100% - 28px), var(--max)); flex-direction: column; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip">跳到主要内容</a>

  <SiteHeader />
  <MascotCompanion />

  <main id="main">
    <ProductGroup
      id="products"
      className="hero"
      eyebrowKey="personalProductsEyebrow"
      eyebrow="可直接体验的个人产品"
      products={personalProducts}
    />

    <section class="section section-tight" id="scenarios">
      <div class="section-heading">
        <p class="eyebrow" data-i18n="scenarioEyebrow">按你的目标选择</p>
        <h2 data-i18n="scenarioTitle">找到适合你的产品</h2>
      </div>
      <div class="scenario-grid">
        <article class="scenario" id="whiteboard-recorder-scenario">
          <span class="scenario-number">01</span>
          <h3 data-i18n="scenarioRecordTitle">想把讲解过程完整记录下来？</h3>
          <p data-i18n="scenarioRecordDesc">打开白板，边画边讲，完成后直接获得录制内容。适合课程、演示和知识表达。</p>
          <a class="text-link" href="https://record.leewen.work" target="_blank" rel="noopener" data-i18n="recordCta">立即体验</a>
        </article>
        <article class="scenario" id="poetry-graph-scenario">
          <span class="scenario-number">02</span>
          <h3 data-i18n="scenarioPoemTitle">想看见诗词背后的关系？</h3>
          <p data-i18n="scenarioPoemDesc">沿着诗人、时代、地点与作品的连接，发现传统列表之外的阅读路径。</p>
          <a class="text-link" href="https://poem.leewen.work" target="_blank" rel="noopener" data-i18n="poemCta">立即探索</a>
        </article>
      </div>
    </section>

    <ProductGroup
      id="professional-work"
      className="professional-group"
      eyebrowKey="professionalEyebrow"
      eyebrow="专业作品"
      titleKey="professionalTitle"
      title="银行数据与风险管理作品"
      leadKey="professionalLead"
      lead="面向银行业务、数据与风险管理场景，展示我如何把复杂规则、分析模型和系统流程转化为可理解、可验证的产品。"
      products={professionalProducts}
    />

    {detailedProducts.map((product) => <ProductDetail product={product} />)}

    <div class="demo-band">
      <section class="section">
        <div class="section-heading">
          <p class="eyebrow" data-i18n="stepsEyebrow">简单开始</p>
          <h2 data-i18n="stepsTitle">从打开产品到获得结果</h2>
        </div>
        <div class="steps-grid">
          <article class="step-card">
            <span class="step-number">1</span>
            <h3 data-i18n="stepOneTitle">选择产品</h3>
            <p data-i18n="stepOneDesc">根据你的任务，进入白板录屏工具或诗词图谱。</p>
          </article>
          <article class="step-card">
            <span class="step-number">2</span>
            <h3 data-i18n="stepTwoTitle">直接体验</h3>
            <p data-i18n="stepTwoDesc">无需先阅读冗长介绍，进入产品后再探索适合你的功能。</p>
          </article>
          <article class="step-card">
            <span class="step-number">3</span>
            <h3 data-i18n="stepThreeTitle">告诉我反馈</h3>
            <p data-i18n="stepThreeDesc">使用中遇到问题或有新的想法，可以通过邮件或微信联系我。</p>
          </article>
        </div>
      </section>
    </div>

    <section class="section" id="creator">
      <div class="creator-card">
        <div class="portrait-frame">
          <img src="/images/portrait.jpg" alt="lijiawen 的彩铅人物肖像" data-i18n-alt="portraitAlt">
        </div>
        <div class="creator-copy">
          <p class="eyebrow" data-i18n="creatorEyebrow">产品背后的创作者</p>
          <h2 data-i18n="creatorTitle">经验用来建立信任，产品用来创造价值。</h2>
          <p class="lead" data-i18n="creatorLead">我是 lijiawen，一名拥有 22 年产品与系统经验的独立产品创作者。我长期处理复杂业务、数据和系统问题，现在把这些经验变成普通用户可以直接使用的产品。</p>
          <ul class="trust-tags">
            <li data-i18n="trustOne">22 年产品与系统经验</li>
            <li data-i18n="trustTwo">10 年银行数据产品</li>
            <li>PMP</li>
            <li data-i18n="trustFour">从需求到可运行产品</li>
          </ul>
          <details class="about-details">
            <summary data-i18n="aboutToggle">进一步了解我</summary>
            <div class="about-copy">
              <h3 data-i18n="aboutWhoTitle">我是谁？</h3>
              <p data-i18n="aboutWho">一名长期深耕银行数据与监管科技的产品经理。近五年，我一直致力于探索图数据库在银行监管、流动性风险、FTP 与资产负债管理中的应用，把复杂的数据关系转化为清晰、可追溯、可落地的系统。</p>
              <h3 data-i18n="aboutBelieveTitle">我相信什么？</h3>
              <p data-i18n="aboutBelieve">我相信，银行业务是 AI 服务最值得长期投入的领域之一。监管不是阻力，而是专业能力的护城河。AI 不会取代行业经验，而会放大真正懂业务、懂数据、懂系统的人的价值。</p>
              <h3 data-i18n="aboutSeekTitle">我在找什么？</h3>
              <p data-i18n="aboutSeekOne">我在寻找真实而有价值的问题，并尝试把我的经验、快速理解复杂业务的能力与 AI 结合，转化为真正能够帮助他人的产品与解决方案。</p>
              <p data-i18n="aboutSeekTwo">我希望做的，不只是完成一项工作，而是持续创造清晰、可靠、可落地的价值。</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <section class="section" id="articles">
      <div class="section-heading">
        <p class="eyebrow" data-i18n="articlesEyebrow">教程 · 案例 · 创作记录</p>
        <h2 data-i18n="articlesTitle">了解产品如何使用与成长</h2>
        <p class="lead" data-i18n="articlesLead">从快速上手到产品背后的思考，这里记录真实的使用方式和持续改进。</p>
      </div>
      <div class="article-grid">
        <article class="article-card">
          <span class="article-type" data-i18n="typeTutorial">快速上手</span>
          <h3 data-i18n="articleOneTitle">如何完成一次清晰的白板录屏</h3>
          <p data-i18n="articleOneDesc">从准备内容、边讲边画，到检查录制结果的简单流程。</p>
          <a class="text-link" href="https://record.leewen.work" target="_blank" rel="noopener" data-i18n="tryProduct">先体验产品</a>
        </article>
        <article class="article-card">
          <span class="article-type" data-i18n="typeStory">创作故事</span>
          <h3 data-i18n="articleTwoTitle">我为什么做诗词图谱</h3>
          <p data-i18n="articleTwoDesc">当诗人、时代和作品连接起来，诗词会呈现出怎样的新阅读方式？</p>
          <a class="text-link" href="https://poem.leewen.work" target="_blank" rel="noopener" data-i18n="exploreProduct">先探索产品</a>
        </article>
        <article class="article-card">
          <span class="article-type" data-i18n="typeBuild">产品构建</span>
          <h3 data-i18n="articleThreeTitle">为什么把房贷止赎数据流程梳理成产品</h3>
          <p data-i18n="articleThreeDesc">当数据血缘清晰可追溯，业务团队和技术团队可以更快定位数据来源、理解计算逻辑。</p>
          <a class="text-link" href="https://wen001-git.github.io/ForeclosureRule2/" target="_blank" rel="noopener" data-i18n="tryProduct">先体验产品</a>
        </article>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="contact-card">
        <div>
          <p class="eyebrow" data-i18n="contactEyebrow">反馈与合作</p>
          <h2 data-i18n="contactTitle">使用产品时遇到问题？</h2>
          <p data-i18n="contactLead">欢迎告诉我你的使用体验、问题和建议。如果你有产品合作或一件值得共同完成的事，也可以直接联系我。</p>
          <div class="contact-actions">
            <a class="button button-primary" href="#products" data-i18n="allProducts">查看全部产品</a>
            <a class="button button-secondary" href="mailto:8639210@qq.com" data-i18n="emailMe">发送邮件</a>
            <a class="button button-secondary" href="https://github.com/wen001-git/" target="_blank" rel="noopener">GitHub</a>
          </div>
        </div>
        <div class="qr-card">
          <img src="/images/wechat-qr.jpg" alt="微信账号 leewen2017 的二维码" data-i18n-alt="qrAlt">
          <strong>微信 · leewen2017</strong>
          <small data-i18n="qrNote">添加时请备注：产品名称 / 合作</small>
        </div>
      </div>
    </section>
  </main>


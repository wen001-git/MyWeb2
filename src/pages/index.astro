---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="白板录屏工具、诗词图谱与房贷止赎数据血缘的产品介绍和体验入口。">
  <meta name="theme-color" content="#f7f3ea">
  <title>LEEWEN · 白板录屏工具、诗词图谱与房贷止赎数据血缘</title>
  <style is:global>
    :root {
      --paper: #f7f3ea;
      --paper-deep: #eee7da;
      --card: #fffdf8;
      --ink: #20242b;
      --navy: #263b5a;
      --navy-soft: #3e577a;
      --orange: #c7653d;
      --orange-dark: #a84c2c;
      --muted: #667085;
      --line: #ded8cc;
      --green: #496b5b;
      --shadow: 0 18px 50px rgba(38, 59, 90, .10);
      --radius-lg: 28px;
      --radius-md: 18px;
      --max: 1180px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 8% 5%, rgba(199, 101, 61, .08), transparent 27rem),
        radial-gradient(circle at 92% 14%, rgba(38, 59, 90, .08), transparent 30rem),
        var(--paper);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
        "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; }
    img { display: block; max-width: 100%; }
    button, a { -webkit-tap-highlight-color: transparent; }

    .skip-link {
      position: fixed;
      z-index: 1000;
      top: 10px;
      left: 10px;
      padding: 10px 14px;
      border-radius: 10px;
      color: #fff;
      background: var(--navy);
      transform: translateY(-160%);
    }
    .skip-link:focus { transform: translateY(0); }

    .site-header {
      position: sticky;
      z-index: 100;
      top: 0;
      border-bottom: 1px solid rgba(222, 216, 204, .82);
      background: rgba(247, 243, 234, .88);
      backdrop-filter: blur(16px);
    }

    .nav-wrap {
      position: relative;
      width: min(calc(100% - 40px), var(--max));
      min-height: 72px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: inline-flex;
      align-items: baseline;
      gap: 9px;
      text-decoration: none;
      font-weight: 850;
      letter-spacing: .12em;
      color: var(--navy);
    }
    .brand small {
      font-weight: 650;
      letter-spacing: .08em;
      color: var(--muted);
    }

    .nav-panel {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .nav-links a {
      padding: 9px 10px;
      border-radius: 10px;
      color: var(--muted);
      text-decoration: none;
      font-size: .94rem;
      font-weight: 650;
    }
    .nav-links a:hover,
    .nav-links a:focus-visible {
      color: var(--navy);
      background: rgba(38, 59, 90, .06);
    }

    .lang-switch {
      display: flex;
      gap: 3px;
      padding: 3px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
    }
    .lang-switch button {
      min-width: 38px;
      padding: 6px 8px;
      border: 0;
      border-radius: 8px;
      color: var(--muted);
      background: transparent;
      font: inherit;
      font-size: .8rem;
      font-weight: 800;
      cursor: pointer;
    }
    .lang-switch button[aria-pressed="true"] {
      color: #fff;
      background: var(--navy);
    }

    .menu-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: var(--navy);
      background: var(--card);
      font: inherit;
      font-weight: 850;
      cursor: pointer;
    }

    .button {
      display: inline-flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 18px;
      border: 1px solid transparent;
      border-radius: 13px;
      text-decoration: none;
      font-weight: 800;
      line-height: 1.2;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .button:hover { transform: translateY(-2px); }
    .button:focus-visible,
    .menu-toggle:focus-visible,
    .lang-switch button:focus-visible,
    summary:focus-visible {
      outline: 3px solid rgba(199, 101, 61, .35);
      outline-offset: 3px;
    }
    .button-primary {
      color: #fff;
      background: var(--orange);
      box-shadow: 0 10px 24px rgba(199, 101, 61, .25);
    }
    .button-primary:hover { background: var(--orange-dark); }
    .button-secondary {
      color: var(--navy);
      border-color: var(--line);
      background: rgba(255, 253, 248, .82);
    }
    .button-ink {
      color: #fff;
      background: var(--navy);
    }

    main { overflow: hidden; }
    .section {
      width: min(calc(100% - 40px), var(--max));
      margin: 0 auto;
      padding: 90px 0;
    }
    .section-tight { padding-top: 24px; }
    .section-heading {
      max-width: 720px;
      margin-bottom: 34px;
    }
    .eyebrow {
      margin: 0 0 10px;
      color: var(--orange);
      font-size: .78rem;
      font-weight: 900;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    h1, h2, h3 {
      margin-top: 0;
      color: var(--navy);
      line-height: 1.15;
      letter-spacing: -.03em;
    }
    h1 {
      max-width: 820px;
      margin-bottom: 20px;
      font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
      font-size: clamp(2.6rem, 6vw, 5.4rem);
      font-weight: 800;
    }
    h2 {
      margin-bottom: 12px;
      font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif;
      font-size: clamp(2rem, 4vw, 3.3rem);
    }
    h3 { font-size: 1.35rem; }
    .lead {
      max-width: 760px;
      margin: 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 2vw, 1.28rem);
    }

    .hero { padding-top: 40px; }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .product-card {
      position: relative;
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: rgba(255, 253, 248, .92);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .product-card::after {
      position: absolute;
      right: -60px;
      bottom: -70px;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: rgba(199, 101, 61, .08);
      content: "";
      pointer-events: none;
    }
    .product-card.poetry::after { background: rgba(73, 107, 91, .10); }
    .product-card.fcl::after { background: rgba(38, 59, 90, .10); }
    .product-visual {
      position: relative;
      min-height: 250px;
      margin-bottom: 24px;
      border-radius: 20px;
      background: #f0ebe1;
      overflow: hidden;
    }
    .product-content { padding: 0 10px 10px; }
    .product-label {
      display: inline-flex;
      margin-bottom: 12px;
      padding: 5px 9px;
      border-radius: 99px;
      color: var(--orange-dark);
      background: rgba(199, 101, 61, .11);
      font-size: .76rem;
      font-weight: 850;
    }
    .poetry .product-label {
      color: var(--green);
      background: rgba(73, 107, 91, .11);
    }
    .fcl .product-label {
      color: var(--navy);
      background: rgba(38, 59, 90, .11);
    }
    .product-content h2 {
      margin-bottom: 12px;
      font-family: inherit;
      font-size: clamp(1.65rem, 3vw, 2.25rem);
    }
    .product-content p {
      min-height: 3.3em;
      margin: 0 0 18px;
      color: var(--muted);
    }
    .audience {
      min-height: 2.5em;
      margin-bottom: 20px;
      color: var(--navy);
      font-size: .88rem;
      font-weight: 750;
    }
    .card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .whiteboard-ui {
      position: absolute;
      inset: 18px;
      border: 1px solid #d7d0c4;
      border-radius: 14px;
      background:
        linear-gradient(rgba(38, 59, 90, .05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(38, 59, 90, .05) 1px, transparent 1px),
        #fffdf9;
      background-size: 22px 22px;
      box-shadow: 0 12px 28px rgba(38, 59, 90, .12);
    }
    .tool-rail {
      position: absolute;
      top: 18px;
      left: 18px;
      display: flex;
      gap: 7px;
      padding: 7px;
      border: 1px solid #e4ded4;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 6px 16px rgba(38, 59, 90, .1);
    }
    .tool-rail i {
      display: block;
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: #e9edf3;
    }
    .tool-rail i:nth-child(2) { background: #f1d8cd; }
    .tool-rail i:nth-child(3) { background: #d9e5df; }
    .record-pill {
      position: absolute;
      top: 18px;
      right: 18px;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border-radius: 99px;
      color: #a23124;
      background: #fff;
      box-shadow: 0 6px 16px rgba(38, 59, 90, .1);
      font-size: .72rem;
      font-weight: 900;
    }
    .record-pill::before {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d94b3d;
      content: "";
    }
    .board-note {
      position: absolute;
      left: 18%;
      top: 42%;
      width: 44%;
      padding: 12px;
      border-left: 4px solid var(--orange);
      color: var(--navy);
      background: rgba(255, 248, 212, .88);
      font-family: "Songti SC", serif;
      font-size: 1rem;
      font-weight: 800;
      transform: rotate(-2deg);
    }
    .board-arrow {
      position: absolute;
      right: 18%;
      bottom: 25%;
      width: 26%;
      height: 34px;
      border-bottom: 3px solid var(--navy-soft);
      border-radius: 50%;
      transform: rotate(-10deg);
    }
    .board-arrow::after {
      position: absolute;
      right: -2px;
      bottom: -7px;
      width: 11px;
      height: 11px;
      border-right: 3px solid var(--navy-soft);
      border-bottom: 3px solid var(--navy-soft);
      content: "";
      transform: rotate(-45deg);
    }

    .poetry-map {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 50%, rgba(73, 107, 91, .14), transparent 38%),
        linear-gradient(145deg, #f2ece0, #e8efe9);
    }
    .map-line {
      position: absolute;
      height: 2px;
      background: rgba(38, 59, 90, .28);
      transform-origin: left center;
    }
    .line-a { top: 44%; left: 29%; width: 42%; transform: rotate(-12deg); }
    .line-b { top: 51%; left: 48%; width: 34%; transform: rotate(33deg); }
    .line-c { top: 51%; left: 20%; width: 32%; transform: rotate(41deg); }
    .line-d { top: 33%; left: 48%; width: 28%; transform: rotate(-48deg); }
    .map-node {
      position: absolute;
      display: grid;
      place-items: center;
      width: 76px;
      aspect-ratio: 1;
      border: 2px solid rgba(255, 255, 255, .88);
      border-radius: 50%;
      color: #fff;
      background: var(--navy);
      box-shadow: 0 10px 24px rgba(38, 59, 90, .2);
      font-family: "Songti SC", serif;
      font-weight: 850;
    }
    .node-main { top: 34%; left: calc(50% - 38px); width: 88px; background: var(--orange); }
    .node-a { top: 14%; left: 18%; }
    .node-b { top: 14%; right: 15%; background: var(--green); }
    .node-c { bottom: 12%; left: 18%; background: var(--navy-soft); }
    .node-d { right: 14%; bottom: 11%; background: #8b674e; }

    /* FCL Pipeline Explorer — 数据血缘 / 多层 Pipeline 视觉 */
    .lineage-ui {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 50%, rgba(38, 59, 90, .12), transparent 40%),
        linear-gradient(160deg, #e9ecf2, #dfe3eb);
    }
    .lineage-edge {
      position: absolute;
      height: 2px;
      background: linear-gradient(to right, rgba(38, 59, 90, .45), rgba(38, 59, 90, .15));
      transform-origin: left center;
    }
    .lineage-edge.edge-1 { top: 38%; left: 22%; width: 30%; transform: rotate(20deg); }
    .lineage-edge.edge-2 { top: 38%; left: 52%; width: 30%; transform: rotate(-20deg); }
    .lineage-edge.edge-3 { top: 56%; left: 30%; width: 22%; transform: rotate(35deg); }
    .lineage-edge.edge-4 { top: 56%; left: 52%; width: 22%; transform: rotate(-35deg); }
    .lineage-edge.edge-5 { top: 47%; left: 26%; width: 48%; transform: rotate(0deg); }
    .lineage-node {
      position: absolute;
      display: grid;
      place-items: center;
      width: 60px;
      aspect-ratio: 1;
      border: 2px solid rgba(255, 255, 255, .92);
      border-radius: 50%;
      color: #fff;
      background: var(--navy);
      box-shadow: 0 8px 20px rgba(38, 59, 90, .22);
      font-size: .72rem;
      font-weight: 850;
      text-align: center;
      line-height: 1.1;
      padding: 4px;
    }
    .lineage-node.node-source-a { top: 24%; left: 14%; background: var(--orange); width: 70px; }
    .lineage-node.node-source-b { top: 24%; right: 14%; background: var(--navy-soft); width: 70px; }
    .lineage-node.node-app { top: 50%; left: calc(50% - 42px); width: 84px; background: var(--navy); }
    .lineage-node.node-report { bottom: 12%; left: calc(50% - 32px); background: var(--green); width: 64px; }
    .lineage-pill {
      position: absolute;
      top: 14px;
      right: 14px;
      padding: 4px 9px;
      border-radius: 99px;
      color: var(--navy);
      background: rgba(255, 255, 255, .82);
      font-size: .7rem;
      font-weight: 850;
      letter-spacing: .04em;
    }

    .scenario-grid,
    .steps-grid,
    .article-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .scenario,
    .step-card,
    .article-card {
      padding: 26px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: rgba(255, 253, 248, .72);
    }
    .scenario-number,
    .step-number {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      margin-bottom: 30px;
      border-radius: 10px;
      color: #fff;
      background: var(--navy);
      font-weight: 900;
    }
    .scenario p,
    .step-card p,
    .article-card p { color: var(--muted); }
    .text-link {
      color: var(--orange-dark);
      font-weight: 850;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
    }

    .demo-band {
      border-block: 1px solid var(--line);
      background: rgba(238, 231, 218, .52);
    }
    .steps-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .step-card { background: var(--card); }
    .step-number { margin-bottom: 20px; background: var(--orange); }

    .creator-card {
      display: grid;
      grid-template-columns: minmax(260px, .72fr) minmax(0, 1.28fr);
      gap: 46px;
      align-items: center;
      padding: clamp(22px, 5vw, 54px);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--card);
      box-shadow: var(--shadow);
    }
    .portrait-frame {
      position: relative;
      max-width: 390px;
      margin: 0 auto;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: var(--paper);
      transform: rotate(-1.2deg);
    }
    .portrait-frame::before {
      position: absolute;
      inset: 8px -8px -8px 8px;
      z-index: -1;
      border: 2px solid rgba(199, 101, 61, .28);
      border-radius: 28px;
      content: "";
    }
    .portrait-frame img {
      width: 100%;
      border-radius: 20px;
      filter: sepia(.08) contrast(.98);
    }
    .trust-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 24px 0;
      padding: 0;
      list-style: none;
    }
    .trust-tags li {
      padding: 7px 11px;
      border: 1px solid var(--line);
      border-radius: 99px;
      color: var(--navy);
      background: var(--paper);
      font-size: .83rem;
      font-weight: 750;
    }
    .about-details {
      margin-top: 24px;
      border-top: 1px solid var(--line);
      padding-top: 18px;
    }
    .about-details summary {
      width: max-content;
      color: var(--orange-dark);
      font-weight: 850;
      cursor: pointer;
    }
    .about-copy {
      max-width: 720px;
      padding-top: 12px;
      color: var(--muted);
    }
    .about-copy h3 { margin: 22px 0 6px; color: var(--navy); }

    .article-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .article-card {
      display: flex;
      min-height: 240px;
      flex-direction: column;
    }
    .article-type {
      margin-bottom: 24px;
      color: var(--green);
      font-size: .76rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .article-card h3 { margin-bottom: 10px; }
    .article-card p { margin-top: 0; }
    .article-card .text-link { margin-top: auto; }

    .contact-card {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(220px, .6fr);
      gap: 44px;
      align-items: center;
      padding: clamp(26px, 6vw, 64px);
      border-radius: var(--radius-lg);
      color: #fff;
      background: var(--navy);
      overflow: hidden;
    }
    .contact-card::after {
      position: absolute;
      top: -90px;
      right: -70px;
      width: 290px;
      height: 290px;
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 50%;
      content: "";
    }
    .contact-card h2,
    .contact-card .eyebrow { color: #fff; }
    .contact-card p { max-width: 650px; color: rgba(255, 255, 255, .72); }
    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
    }
    .contact-actions .button-secondary {
      color: #fff;
      border-color: rgba(255, 255, 255, .24);
      background: rgba(255, 255, 255, .08);
    }
    .qr-card {
      position: relative;
      z-index: 1;
      padding: 14px;
      border-radius: 18px;
      color: var(--ink);
      background: #fff;
      text-align: center;
    }
    .qr-card img {
      width: 100%;
      max-width: 220px;
      margin: 0 auto;
      border-radius: 8px;
    }
    .qr-card strong { display: block; margin-top: 10px; }
    .qr-card small { color: var(--muted); }

    footer {
      width: min(calc(100% - 40px), var(--max));
      margin: 0 auto;
      padding: 34px 0 44px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: .86rem;
    }
    footer a { color: var(--navy); }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 1100px) {
      .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 900px) {
      .nav-panel { gap: 10px; }
      .nav-links { display: none; }
      .product-grid,
      .creator-card,
      .contact-card { grid-template-columns: 1fr; }
      .product-card { max-width: 720px; }
      .product-grid { justify-items: center; }
      .creator-card { gap: 30px; }
      .creator-copy { order: -1; }
      .portrait-frame { max-width: 320px; }
      .article-grid { grid-template-columns: 1fr; }
      .article-card { min-height: auto; }
      .qr-card { max-width: 250px; }
    }

    @media (max-width: 720px) {
      .nav-wrap { width: min(calc(100% - 28px), var(--max)); }
      .menu-toggle { display: inline-grid; place-items: center; }
      .nav-panel {
        position: absolute;
        top: 62px;
        right: 0;
        width: min(320px, calc(100vw - 28px));
        padding: 14px;
        display: none;
        align-items: stretch;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--card);
        box-shadow: var(--shadow);
      }
      .nav-panel[data-open="true"] { display: grid; }
      .nav-links { display: grid; }
      .nav-links a { padding: 11px 12px; }
      .lang-switch { width: max-content; }
      .nav-cta { width: 100%; }
      .section {
        width: min(calc(100% - 28px), var(--max));
        padding: 68px 0;
      }
      .hero { padding-top: 24px; }
      .product-grid,
      .scenario-grid,
      .steps-grid { grid-template-columns: 1fr; }
      .product-card { padding: 12px; border-radius: 22px; }
      .product-visual { min-height: 220px; }
      .product-content { padding: 0 6px 8px; }
